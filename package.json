{
	"name": "@firefoxic/bemlint",
	"description": "CLI tool for linting HTML using BEM methodology.",
	"version": "7.0.1",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/bemlint#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/bemlint/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/bemlint.git"
	},
	"type": "module",
	"bin": {
		"bemlint": "./dist/bin/cli.js"
	},
	"types": "./dist/lib/bemlint.d.ts",
	"exports": {
		".": {
			"types": "./dist/lib/bemlint.d.ts",
			"import": "./dist/lib/bemlint.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"./dist/"
	],
	"engines": {
		"node": "^22.18 || ^24.15 || >=26.13"
	},
	"dependencies": {
		"parse5": "^8.1.1",
		"parse5-htmlparser2-tree-adapter": "^8.0.2"
	},
	"scripts": {
		"help": "make help",
		"prepack": "git config --local core.hooksPath .githooks || true"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.13",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.22",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "~0.7",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^5",
		"@vitest/ui": "5",
		"oxlint": "^1",
		"tsrs": "latest",
		"vitest": "^5"
	},
	"keywords": [
		"cli",
		"html",
		"bem",
		"linter",
		"bemlint"
	]
}
