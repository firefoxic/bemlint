{
	"name": "@firefoxic/bemlint",
	"description": "CLI tool for linting HTML using BEM methodology.",
	"version": "6.0.5",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/bemlint#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/bemlint/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/bemlint.git"
	},
	"type": "module",
	"bin": {
		"bemlint": "./dist/bin/cli.js"
	},
	"exports": {
		".": {
			"import": "./dist/lib/bemlint.js",
			"types": "./dist/lib/bemlint.d.ts"
		}
	},
	"files": [
		"./dist/"
	],
	"engines": {
		"node": ">=22.18"
	},
	"dependencies": {
		"parse5": "^8.0.1",
		"parse5-htmlparser2-tree-adapter": "^8.0.1"
	},
	"scripts": {
		"help": "make help"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.7",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=11.21",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "^0.4.0",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "4.1.10",
		"oxlint": "^1.78.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"cli",
		"html",
		"bem",
		"linter",
		"bemlint"
	]
}
